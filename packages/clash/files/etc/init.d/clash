#!/bin/sh /etc/rc.common
# Copyright (C) 2008-2012 OpenWrt.org

START=99
USE_PROCD=1

PROG='clash'
clash_exe='/var/clash/clash'


DNSMASQ_UCI_CONFIG="$(uci -q show "dhcp.@dnsmasq[0]" | awk 'NR==1 {split($0, conf, /[.=]/); print conf[2]}')"
if [ -f "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG" ];then
        DNSMASQ_CLASH="$(awk -F '=' '/^conf-dir=/ {print $2}' "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG")/redirect2clash.conf"
else
        DNSMASQ_CLASH="/tmp/dnsmasq.d/redirect2clash.conf"
fi

service_triggers()
{
	procd_add_config_trigger "config.change" "${PROG}" /etc/init.d/"${PROG}" restart
}

find_clash()
{
	if [ ! -e "$clash_exe" ]; then
		for _i in 1 2 3; do
			local bin_name="$(uci -q get clash.main.name)"
			[ "$bin_name" != "" ] || bin_name="clash"

			for link in $(uci -q get clash.main.link); do
				if [ -z "$link" ]; then
					continue
				fi
				if [ `curl -I -sL --connect-timeout 5 "${link}" | head -n 1 | grep -c 200` -eq 1 ]; then
					curl -sL "${link}" | gunzip -c | tar -xvf - -C /var/clash/
					if [ $? -eq 0 ]; then
						break
					fi
				fi
			done
			for _file in `find /var/clash -name "${bin_name}-*" 2>/dev/null`; do
				if [ "$_file" != "" ]; then
					mv "$_file" "$clash_exe"
					chmod +x "$clash_exe"
					return
				fi
			done
			sleep 10s
		done
	fi
}

start_service() {
	local clash_conf="$(uci -q get clash.main.conf)"
	[ "$clash_conf" != "" ] || clash_conf="/etc/clash/config.yaml"

	mkdir /var/log/clash > /dev/null 2>&1
	mkdir -m0755 -p /var/clash >/dev/null 2>&1
 
	find_clash

	$clash_exe -t -d '/var/clash' -f "$clash_conf"
	[ $? -eq 0 ] || return

	procd_open_instance
	procd_set_param respawn
	procd_set_param command $clash_exe -d /var/clash -f "$clash_conf"
	procd_set_param env 'HOME=/var/clash'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/clash.pid
	procd_close_instance

	echo > "$DNSMASQ_CLASH"
	while read line; do
		[ -n "$line" ] || continue
		if [ `echo $line | grep -c '#'` -ne 0 ]; then
			echo "$line" >> "$DNSMASQ_CLASH"
		else
			echo "nftset=/$line/4#inet#fw4#shadowsocks" >> "$DNSMASQ_CLASH"
			echo "server=/$line/127.0.0.1#5353" >> "$DNSMASQ_CLASH"
		fi
	done < /etc/clash/list/shadowsocks.list

	# cat > "$DNSMASQ_CLASH" <<-EOF
	# 	no-resolv
	# 	server=127.0.0.1#5353
	# EOF
	/etc/init.d/dnsmasq restart
}

stop_service() {
	if [ -f "$DNSMASQ_CLASH" ]; then
		rm -f "$DNSMASQ_CLASH"
		/etc/init.d/dnsmasq restart
	fi
}
