#!/bin/sh /etc/rc.common
# Copyright (C) 2008-2012 OpenWrt.org

START=99
USE_PROCD=1

PROG='sing-box'
singbox_exe='/var/sing-box/sing-box'


service_triggers()
{
	procd_add_config_trigger "config.change" "${PROG}" /etc/init.d/"${PROG}" restart
}

find_singbox()
{
	if [ ! -e "$singbox_exe" ]; then
		for _i in 1 2 3; do
			local bin_name="$(uci -q get sing-box.main.name)"
			[ "$bin_name" != "" ] || bin_name="sing-box"

			for link in $(uci -q get sing-box.main.link); do
				if [ -z "$link" ]; then
					continue
				fi
				if [ `curl -I -sL --connect-timeout 5 "${link}" | head -n 1 | grep -c 200` -eq 1 ]; then
					curl -sL "${link}" | gunzip -c | tar -xvf - -C /var/sing-box/
					if [ $? -eq 0 ]; then
						break
					fi
				fi
			done
			mv /var/sing-box/*/sing-box "$singbox_exe"
			if [ -e "$singbox_exe" ]; then
				chmod +x "$singbox_exe"
				return
			fi
			sleep 10s
		done
	fi
}

start_service() {
	local singbox_conf="$(uci -q get sing-box.main.conf)"
	[ "$singbox_conf" != "" ] || singbox_conf="/etc/sing-box/config.json"

	mkdir /var/log/sing-box > /dev/null 2>&1
	mkdir -m0755 -p /var/sing-box >/dev/null 2>&1
 
	find_singbox

	$singbox_exe check -D '/var/sing-box' -c "$singbox_conf"
	[ $? -eq 0 ] || return

	procd_open_instance
	procd_set_param respawn
	procd_set_param command $singbox_exe run -D /var/sing-box -c "$singbox_conf"
	procd_set_param env 'HOME=/var/sing-box'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/sing-box.pid
	procd_close_instance
}
